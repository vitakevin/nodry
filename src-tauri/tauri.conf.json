{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "别太干巴了",
  "version": "0.2.0",
  "identifier": "com.vitakevin.stay-hydrated",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "别太干巴了",
      "width": 420,
      "height": 720,
      "minWidth": 360,
      "minHeight": 620,
      "center": true,
      "backgroundColor": "#f5f4ee",
      "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "HealthcareAndFitness",
    "shortDescription": "干巴值越高，越要记得喝水。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": {
      "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese"], "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
